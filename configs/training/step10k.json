{
  "data": {
    "segments_path": "data/segments.csv",
    "glossary_path": "data/glossary.csv",
    "source_column": "zh-CN",
    "target_column": "ko",
    "id_column": "segment_id"
  },
  "language": {
    "source_code": "zho_Hans",
    "target_code": "kor_Hang"
  },
  "model": {
    "base_model": "facebook/nllb-200-distilled-600M",
    "output_dir": "fine-tuned-models/nllb-200-distilled-600M/zh2ko"
  },
  "split": {
    "train_ratio": 0.8,
    "validation_ratio": 0.1,
    "test_ratio": 0.1,
    "seed": 42
  },
  "tokenization": {
    "max_length": 400,
    "padding": "max_length",
    "truncation": true,
    "terminology_markers": true
  },
  "training": {
    "num_train_epochs": 3,
    "max_steps": 10000,
    "per_device_train_batch_size": 1,
    "per_device_eval_batch_size": 1,
    "gradient_accumulation_steps": 1,
    "learning_rate": 0.00002,
    "warmup_ratio": 0.03,
    "weight_decay": 0.01,
    "max_grad_norm": 1.0,
    "save_steps": 1000,
    "eval_steps": 5000,
    "save_total_limit": 6,
    "logging_steps": 100
  },
  "dry_run": {
    "preview_rows": 3
  }
}
