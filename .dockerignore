.idea/
.vscode/
*.iml
.claude/

# Git
.git/
.gitignore
.gitattributes

# OS metadata
.DS_Store
Thumbs.db

# Jupyter
*.ipynb
.ipynb_checkpoints/

# Raw spreadsheet inputs
*.xlsx
*.xls
*.xlsm

# Local configuration and secrets
.env
.env.*
!.env.example

# Python packaging / build outputs
build/
dist/
*.egg-info/

# CI artifacts
.github/
