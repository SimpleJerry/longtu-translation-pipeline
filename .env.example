# =============================================================================
# longtu-translation-pipeline — environment variable template
# =============================================================================
# Copy this file to `.env` (gitignored) and fill in your own values.
#
# IMPORTANT: This repository does NOT auto-load `.env`. The LLM cleanup
# pipelines read from process environment variables only (see
# scripts/llm_common.py :: resolve_client_config). To use a `.env` file,
# inject it into your PowerShell session before running scripts, e.g.:
#
#   Get-Content .env | ForEach-Object {
#     if ($_ -match '^\s*([^#=\s]+)\s*=\s*(.*)\s*$') {
#       Set-Item -Path "env:$($matches[1])" -Value $matches[2].Trim()
#     }
#   }
#
# Or set them directly per-session:
#   $env:OPENAI_API_KEY = "sk-..."
#   $env:LLM_MODEL      = "gpt-4o-mini"
# =============================================================================


# --- Required for any LLM cleanup pipeline run --------------------------------

# API key for the OpenAI-compatible endpoint. Required by both
# scripts/glossary_llm_cleanup_pipeline.py and
# scripts/segments_llm_cleanup_pipeline.py. Never commit a real key.
OPENAI_API_KEY=sk-REPLACE_ME

# Model identifier passed verbatim to the chat completions endpoint.
# The repo intentionally does not hard-code a default — pick per task.
# Recommended for T-A1 (segments cleanup, ~66k rows, cost-sensitive):
#   gpt-4o-mini
# Other valid examples (depending on your endpoint):
#   gpt-4o, gpt-4-turbo, claude-3-5-sonnet-20241022, qwen2.5-72b-instruct
LLM_MODEL=gpt-4o-mini


# --- Optional ----------------------------------------------------------------

# Override the API base URL. Defaults to https://api.openai.com/v1 when unset.
# Use this for Azure OpenAI, OpenRouter, vLLM, Ollama, or any other
# OpenAI-compatible endpoint.
#   Azure example:    https://<resource>.openai.azure.com/openai/deployments/<deployment>
#   OpenRouter:       https://openrouter.ai/api/v1
#   Local vLLM:       http://localhost:8000/v1
#   Local Ollama:     http://localhost:11434/v1
# OPENAI_BASE_URL=https://api.openai.com/v1


# --- HuggingFace cache (used by training / inference, not LLM cleanup) -------

# Pin the HuggingFace cache to the project venv so large model downloads
# do not pollute the global user profile. Referenced in T-A2 / T-A3 / T-A4.
# HF_HOME=D:\longtu-translation-pipeline\venv\hf_cache


# --- HuggingFace Hub token (model publish / private repo access) --------------

# Token for the PRIVATE model repo SimpleJerry/longtu-nllb-zh2ko.
# - write scope: PUBLISH the fine-tuned checkpoint to the Hub (scripts/publish_model.py).
# - read scope:  PULL the model at serving time when loading from the Hub instead
#                of a local read-only volume (future off-host deployment).
# Create one at https://huggingface.co/settings/tokens. Never commit a real token
# (.env is gitignored; this template ships a placeholder only).
HF_TOKEN=hf_REPLACE_ME
